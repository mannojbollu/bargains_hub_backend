{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bargains-hub-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret config, safe to check in. Everything credential-shaped (JWT signing
  // secret, etc.) is deliberately NOT here — those go through `wrangler secret put`
  // for the deployed Worker, and `.dev.vars` (gitignored) for local dev.
  "vars": {
    // Comma-separated list of origins allowed to call this API with credentials.
    "FRONTEND_ORIGIN": "http://localhost:8080,https://bookish-bargains-hub.books-456.workers.dev,https://bargainnewbooks.com,https://www.bargainnewbooks.com",
    // Where this backend reports its own sales to the warehouse worker. The keys
    // used to authenticate both directions (WAREHOUSE_API_KEY, WAREHOUSE_WEBHOOK_KEY)
    // are secrets -- see README / .dev.vars.example, not here.
    "WAREHOUSE_WEBHOOK_URL": "https://bargainbooks-worker.books-456.workers.dev/api/webhooks/ecom"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookish-bargains-hub-db",
      "database_id": "5e926545-280e-4e0a-a7bb-716a5e99470f",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bookish-bargains-hub-assets"
    }
  ]
}
